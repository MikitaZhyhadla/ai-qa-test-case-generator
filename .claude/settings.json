{
  "permissions": {
    "allow": [
      "Edit(/runs/**)",
      "Bash(node .claude/scripts/workflow-state.js *)",
      "Bash(node .claude/scripts/selftest-hooks.js)",
      "Bash(git remote get-url origin)",
      "WebSearch",
      "WebFetch",
      "mcp__github__issue_read",
      "mcp__github__search_issues",
      "mcp__github__list_issues",
      "mcp__github__add_issue_comment"
    ],
    "deny": [
      "Edit(/runs/*/approval.json)",
      "Edit(/runs/*/workflow-state.json)",
      "Read(/.env)",
      "Read(/.env.*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/approval-gate-guard.js"],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/post-write-state.js"],
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/approval-recorder.js"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
